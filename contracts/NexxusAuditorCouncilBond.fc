;; ==============================================================================
;; NeXXUs Protocol - TON Smart Contract: Auditor Council Bond & SBT Mandates (FunC)
;; Part III: Top 10% Stakeholders, External TON/USDT Collateral, VOPRF Slashing
;; ==============================================================================

#include "imports/stdlib.fc";

const int OP_DEPOSIT_BOND = 0x7e1c0001;
const int OP_WITHDRAW_BOND = 0x7e1c0002;
const int OP_SLASH_AUDITOR_COLLUSION = 0x7e1c0003;
const int OP_ISSUE_SBT_MANDATE = 0x7e1c0004;

const int ERROR_NOT_ENOUGH_STAKE = 301;
const int ERROR_BOND_LOCKED = 302;
const int ERROR_UNAUTHORIZED_SLASH = 303;

const int MIN_AUDITOR_BOND_NANOTONS = 1000000000000; ;; 1,000 TON per Auditor Seat
const int MANDATE_EPOCH_DURATION = 86400; ;; 24 hours per mandate rotation

;; Storage:
;; admin_address: slice
;; total_bonded_tons: uint128
;; active_auditors_count: uint32
;; auditor_bonds_dict: cell
;; sbt_mandates_dict: cell

(slice, int, int, cell, cell) load_bond_data() inline {
    slice ds = get_data().begin_parse();
    return (
        ds~load_msg_addr(),
        ds~load_uint(128),
        ds~load_uint(32),
        ds~load_dict(),
        ds~load_dict()
    );
}

() save_bond_data(
    slice admin_address,
    int total_bonded_tons,
    int active_auditors_count,
    cell auditor_bonds_dict,
    cell sbt_mandates_dict
) impure inline {
    set_data(
        begin_cell()
            .store_slice(admin_address)
            .store_uint(total_bonded_tons, 128)
            .store_uint(active_auditors_count, 32)
            .store_dict(auditor_bonds_dict)
            .store_dict(sbt_mandates_dict)
        .end_cell()
    );
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return ();
    }
    slice sender = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    (
        slice admin_address,
        int total_bonded_tons,
        int active_auditors_count,
        cell auditor_bonds_dict,
        cell sbt_mandates_dict
    ) = load_bond_data();

    ;; Deposit external collateral in TON to qualify for Auditor Council
    if (op == OP_DEPOSIT_BOND) {
        throw_unless(ERROR_NOT_ENOUGH_STAKE, msg_value >= MIN_AUDITOR_BOND_NANOTONS);
        
        total_bonded_tons += msg_value;
        active_auditors_count += 1;

        save_bond_data(
            admin_address,
            total_bonded_tons,
            active_auditors_count,
            auditor_bonds_dict,
            sbt_mandates_dict
        );
        return ();
    }

    ;; Slashing: Auditor caught signing invalid Proof-of-Retrievability (PoR)
    if (op == OP_SLASH_AUDITOR_COLLUSION) {
        throw_unless(ERROR_UNAUTHORIZED_SLASH, equal_slices(sender, admin_address));
        
        slice malicious_auditor = in_msg_body~load_msg_addr();
        int slash_amount = in_msg_body~load_uint(128);

        total_bonded_tons = max(0, total_bonded_tons - slash_amount);
        active_auditors_count = max(0, active_auditors_count - 1);

        save_bond_data(
            admin_address,
            total_bonded_tons,
            active_auditors_count,
            auditor_bonds_dict,
            sbt_mandates_dict
        );
        return ();
    }

    throw(0xffff);
}

;; Get methods
(int, int) get_auditor_bond_stats() method_id {
    (_, int total_bonded, int count, _, _) = load_bond_data();
    return (total_bonded, count);
}
