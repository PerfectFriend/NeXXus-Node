{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx test/protocol.test.ts && tsx test/golden-vectors.test.ts",
    "test:vectors": "tsx test/golden-vectors.test.ts",
    "vectors:gen": "tsx scripts/generate-golden-vectors.ts",
    "linux:daemon": "tsx scripts/linux-daemon.ts",
    "linux:benchmark": "tsx scripts/linux-daemon.ts benchmark",
    "linux:test-por": "tsx scripts/linux-daemon.ts test-por",
    "linux:status": "tsx scripts/linux-daemon.ts status",
    "linux:install": "bash scripts/install-ubuntu.sh",
    "deb:build": "bash scripts/build-deb.sh",
    "bundle:daemon": "esbuild scripts/linux-daemon.ts --bundle --platform=node --format=cjs --outfile=dist/nexxusd.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
